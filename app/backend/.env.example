DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
JWT_SECRET=change_me
PORT=5001

# Set to true ONLY for first-time setup so POST /api/admin/seed-full works without a login.
# Change it back to false after seeding.
ALLOW_SEED=false

# Instructions for Supabase:
# 1. Go to https://supabase.com and create a new project
# 2. Copy the connection string from Project Settings > Database > Connection String
# 3. Replace the DATABASE_URL above with your Supabase connection string
# Format: postgresql://[username]:[password]@[host]:[port]/[database]